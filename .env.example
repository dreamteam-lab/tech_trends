# GitHub collector.
# Создать токен можно в настройках GitHub.
GITHUB_TOKEN=

# PyPI downloads collector через Google BigQuery.
# Локальный путь до application_default_credentials.json.
GCP_ADC_PATH=
GCP_PROJECT_ID=

# Переменные для SeaweedFS (S3-совместимое хранилище).
# Реальные значения — только в локальном .env (в .gitignore, в Git не попадает).
# Сгенерировать случайные значения можно так: openssl rand -hex 20

SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=

# Внешний порт Spark UI.
# Измените, если порт 8080 занят на компьютере.
SPARK_UI_PORT=8080

# Хранилище исходных ответов коллекторов:
# local — сохранять JSON в data/raw;
# s3 — загружать JSON в Bronze-бакет SeaweedFS.
RAW_STORAGE_BACKEND=local

# Адрес SeaweedFS внутри Docker-сети.
S3_ENDPOINT_URL=http://seaweedfs:8333

# Бакет Bronze для исходных ответов API.
S3_BRONZE_BUCKET=tech-trends-bronze
